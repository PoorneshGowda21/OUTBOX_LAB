generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  email            String            @unique
  name             String
  avatar           String?
  googleId         String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  slackIntegration SlackIntegration?
  emailJobs        EmailJob[]

  @@map("users")
}

model Sender {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  email       String     @unique
  name        String
  hourlyLimit Int        @default(50)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  emailJobs   EmailJob[]

  @@map("senders")
}

model EmailJob {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  userId               String?   @db.ObjectId
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  senderId             String?   @db.ObjectId
  sender               Sender?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderEmail          String
  recipientEmail       String
  subject              String
  body                 String
  status               String    @default("SCHEDULED") // PENDING, SCHEDULED, PROCESSING, SENT, FAILED, RATE_LIMITED_RESCHEDULED, CANCELLED
  scheduledAt          DateTime
  sentAt               DateTime?
  attempts             Int       @default(0)
  lastError            String?
  idempotencyKey       String    @unique
  bullJobId            String?
  delayBetweenEmailsMs Int       @default(2000)
  hourlyLimit          Int       @default(50)
  etherealMessageId    String?
  etherealPreviewUrl   String?
  metadata             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([senderEmail])
  @@index([recipientEmail])
  @@map("email_jobs")
}

model SlackIntegration {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @unique @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookUrl     String?
  channel        String?
  teamName       String?
  accessToken    String?
  isConnected    Boolean   @default(false)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("slack_integrations")
}

model RateLimitLog {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  senderEmail     String
  hourWindow      String
  sentCount       Int       @default(0)
  limit           Int
  slackNotified   Boolean   @default(false)
  slackNotifiedAt DateTime?
  createdAt       DateTime  @default(now())

  @@unique([senderEmail, hourWindow])
  @@map("rate_limit_logs")
}
