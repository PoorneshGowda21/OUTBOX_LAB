{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Production-grade Email Job Scheduler with BullMQ, Redis, PostgreSQL, Ethereal SMTP, and Slack Alerts",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node src/prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:duplicates": "node scripts/simulate-crash-duplicate-test.js",
    "test:concurrency": "node scripts/test-concurrent-workers.js",
    "test:recovery": "node scripts/test-failure-recovery.js"
  },
  "dependencies": {
    "@bull-board/api": "^6.8.0",
    "@bull-board/express": "^6.8.0",
    "@elastic/elasticsearch": "^8.17.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
