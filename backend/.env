# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Scheduler & Worker Settings
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
DEFAULT_HOURLY_LIMIT_PER_SENDER=50

# Elasticsearch (Optional - has automatic DB fallback search)
ELASTICSEARCH_NODE=http://localhost:9200

# Slack Integration (OAuth or Incoming Webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback
DEFAULT_SLACK_WEBHOOK_URL=

# Google OAuth (Optional - dashboard supports both real Google OAuth & one-click session)
GOOGLE_CLIENT_ID=
